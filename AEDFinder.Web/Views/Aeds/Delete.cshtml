@model AEDFinder.Web.Models.Aed
@{
    ViewData["Title"] = "AED verwijderen";
}

<h1>Weet je zeker dat je deze AED wilt verwijderen?</h1>
<p class="text-muted">De AED verdwijnt direct uit de kaart en is niet meer zichtbaar voor hulpverleners.</p>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5">@(!string.IsNullOrWhiteSpace(Model.DisplayName) ? Model.DisplayName : "AED locatie")</h2>
        <p>@Model.Street @Model.HouseNumber<br />@Model.PostalCode @Model.City</p>
        @if (!string.IsNullOrWhiteSpace(Model.AccessInstructions))
        {
            <p><strong>Toegang:</strong> @Model.AccessInstructions</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.LastMinuteInstructions))
        {
            <p><strong>Laatste instructies:</strong> @Model.LastMinuteInstructions</p>
        }
    </div>
</div>

<form asp-action="Delete" method="post" class="d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Ja, verwijderen</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Annuleren</a>
</form>
