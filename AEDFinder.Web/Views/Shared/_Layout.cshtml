<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @ViewBag.BrandName</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AEDFinder.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        :root {
            --theme-primary: @(ViewBag.ThemePrimaryColor ?? "#006837");
            --theme-accent: @(ViewBag.ThemeAccentColor ?? "#24A148");
        }

        header .navbar {
            background-color: var(--theme-primary) !important;
        }

        header .navbar .nav-link,
        header .navbar .navbar-brand {
            color: #fff !important;
        }

        header .navbar .nav-link.active,
        header .navbar .nav-link:hover {
            color: var(--theme-accent) !important;
        }

        .btn-primary {
            background-color: var(--theme-primary);
            border-color: var(--theme-primary);
        }

        .btn-primary:hover,
        .btn-primary:focus {
            background-color: var(--theme-accent);
            border-color: var(--theme-accent);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Finder">
                    @if (ViewBag.ThemeLogoPath is string logo && !string.IsNullOrWhiteSpace(logo))
                    {
                        <img src="@logo" alt="@ViewBag.BrandName" style="height:36px;" />
                    }
                    <span>@ViewBag.BrandName</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Finder">Zoek een AED</a>
                        </li>
                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Aeds" asp-action="Index">Mijn AEDs</a>
                            </li>
                        }
                    </ul>
                    @if (IsSectionDefined("HeaderActions"))
                    {
                        <div class="navbar-actions d-flex align-items-center gap-2 me-3">
                            @await RenderSectionAsync("HeaderActions")
                        </div>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - @ViewBag.BrandName - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
